{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "mechdaily",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Mech Daily: open today's post",
        "description": "Creates today's post if it doesn't exist",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Mech Daily: run tournament now",
        "description": "Ends the current day early (testing)",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/run-tournament"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "mechdaily_dev"
  },
  "scheduler": {
    "tasks": {
      "daily-rollover": {
        "endpoint": "/internal/scheduler/daily-rollover",
        "cron": "0 0 * * *"
      }
    }
  },
  "permissions": {
    "reddit": {
      "enable": true
    }
  }
}